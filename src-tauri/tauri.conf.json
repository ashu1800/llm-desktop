{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LLM Gateway",
  "mainBinaryName": "llm-desktop",
  "version": "0.1.0",
  "identifier": "com.llmgateway.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LLM Gateway",
        "width": 1280,
        "height": 820,
        "minWidth": 1000,
        "minHeight": 680,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQyNTkzNzM2NjAxOTM0M0EKUldRNk5CbGdOamRaMHFaRFJqTzVRYUxCV00rYU5teFVPM0tDSU1RZ1NoQXJYZlJmN3NlN2EzaC8K",
      "endpoints": [
        "https://github.com/ashu1800/llm-desktop/releases/latest/download/latest.json"
      ]
    }
  }
}
